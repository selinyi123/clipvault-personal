{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipvault.local/contracts/v2_daily_owner_evidence.schema.json",
  "title": "ClipVault v2 daily-use Owner evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "candidate_commit",
    "source_candidate_dir",
    "source_manifest_path",
    "source_manifest_sha256",
    "build_receipt_path",
    "build_receipt_sha256",
    "workflow_run_url",
    "android_ime_path",
    "android_ime_sha256",
    "android_ime_apksigner_report_path",
    "android_ime_apksigner_report_sha256",
    "android_runtime_path",
    "android_runtime_sha256",
    "android_runtime_apksigner_report_path",
    "android_runtime_apksigner_report_sha256",
    "android_signing_cert_sha256",
    "desktop_executable_path",
    "desktop_executable_sha256",
    "windows_package_path",
    "windows_package_sha256",
    "windows_installer_path",
    "windows_installer_sha256",
    "windows_authenticode_report_path",
    "windows_authenticode_report_sha256",
    "windows_signing_thumbprint",
    "android_manual_pass",
    "windows_manual_pass",
    "otp_manual_pass",
    "seven_day_daily_use_pass",
    "license_and_notices_approved",
    "owner_approved",
    "owner_name",
    "decision_at_utc",
    "evidence_location"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "candidate_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "candidate_commit": { "$ref": "#/$defs/gitSha" },
    "source_candidate_dir": { "$ref": "#/$defs/evidencePath" },
    "source_manifest_path": { "$ref": "#/$defs/evidencePath" },
    "source_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "build_receipt_path": { "$ref": "#/$defs/evidencePath" },
    "build_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "workflow_run_url": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/actions/runs/[1-9][0-9]*$" },
    "android_ime_path": { "$ref": "#/$defs/evidencePath" },
    "android_ime_sha256": { "$ref": "#/$defs/sha256" },
    "android_ime_apksigner_report_path": { "$ref": "#/$defs/evidencePath" },
    "android_ime_apksigner_report_sha256": { "$ref": "#/$defs/sha256" },
    "android_runtime_path": { "$ref": "#/$defs/evidencePath" },
    "android_runtime_sha256": { "$ref": "#/$defs/sha256" },
    "android_runtime_apksigner_report_path": { "$ref": "#/$defs/evidencePath" },
    "android_runtime_apksigner_report_sha256": { "$ref": "#/$defs/sha256" },
    "android_signing_cert_sha256": { "$ref": "#/$defs/sha256" },
    "desktop_executable_path": { "$ref": "#/$defs/evidencePath" },
    "desktop_executable_sha256": { "$ref": "#/$defs/sha256" },
    "windows_package_path": { "$ref": "#/$defs/evidencePath" },
    "windows_package_sha256": { "$ref": "#/$defs/sha256" },
    "windows_installer_path": { "$ref": "#/$defs/evidencePath" },
    "windows_installer_sha256": { "$ref": "#/$defs/sha256" },
    "windows_authenticode_report_path": { "$ref": "#/$defs/evidencePath" },
    "windows_authenticode_report_sha256": { "$ref": "#/$defs/sha256" },
    "windows_signing_thumbprint": { "type": "string", "pattern": "^(?!0+$)[0-9A-Fa-f]{40,128}$" },
    "android_manual_pass": { "type": "boolean" },
    "windows_manual_pass": { "type": "boolean" },
    "otp_manual_pass": { "type": "boolean" },
    "seven_day_daily_use_pass": { "type": "boolean" },
    "license_and_notices_approved": { "type": "boolean" },
    "owner_approved": { "type": "boolean" },
    "owner_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "decision_at_utc": { "type": "string", "format": "date-time" },
    "evidence_location": { "type": "string", "minLength": 1, "maxLength": 1024 }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^(?!0{40}$)[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^(?!0{64}$)[0-9A-Fa-f]{64}$" },
    "evidencePath": { "type": "string", "minLength": 1, "maxLength": 4096 }
  }
}
