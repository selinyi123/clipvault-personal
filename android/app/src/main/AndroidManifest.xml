<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission
        android:name="com.clipvault.permission.RUNTIME_SNAPSHOT"
        android:protectionLevel="signature" />

    <!-- Sync talks to the desktop over LAN/Tailscale. No background clipboard
         polling: Android 10+ forbids it, and we never request it (ADR-0004). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- SYNC-2 uses plain HTTP to the desktop over LAN/Tailscale (THREAT_MODEL:
         LAN cleartext is an accepted residual risk; Tailscale recommended).
         Android 9+ blocks cleartext by default, so we must opt in or sync fails. -->
    <application
        android:name=".ClipVaultApp"
        android:label="ClipVault"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">

        <!-- Explicit Binder/Messenger bridge for the separately installed,
             networkless IME APK. Signature permission is enforced before bind. -->
        <service
            android:name=".runtime.ClipVaultSnapshotBrokerService"
            android:exported="true"
            android:permission="com.clipvault.permission.RUNTIME_SNAPSHOT" />

        <!-- Main UI: history, search, pairing, settings -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".otp.OtpRelaySettingsActivity"
            android:exported="false"
            android:label="OTP Relay" />

        <!-- Started only by an explicit tap in OTP settings. It dynamically
             accepts a GMS-signature-protected consent broadcast, then launches
             the system dialog for exactly one SMS message. -->
        <activity
            android:name=".otp.OtpUserConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="短信验证码逐条确认"
            android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar" />

        <!-- Share Target: the PRIMARY capture path on Android -->
        <activity
            android:name=".share.ShareReceiverActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- QS Tile foreground trampoline. Android 10+ only exposes clipboard
             data to the focused app (or the default IME), so the TileService
             delegates the explicit tap here and this non-exported activity
             reads only after its window receives focus. -->
        <activity
            android:name=".capture.ClipboardCaptureActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <!-- Quick Settings Tile: save the current clipboard with one tap -->
        <service
            android:name=".tile.SaveClipboardTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_save"
            android:label="Save to ClipVault"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Periodic sync fallback when the app is not in the foreground -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge"
            xmlns:tools="http://schemas.android.com/tools" />
    </application>
</manifest>
